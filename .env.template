# .env.template — 部署时复制为 /home/agent/.env 并填入真实值（chmod 600，永不进 git）
# 真实值见加密包 secrets.zip（密码在本地 README-SECRET.txt）

# ---- 方舟模型（山水大脑）----
ARK_API_KEY=sk-xxxx                    # 火山方舟 API Key（推理用，ep 端点对应）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_LITE=doubao-seed-evolving-xxx   # 轻量模型 endpoint
ARK_MODEL_PRO=ep-20261013070524-xjjn2     # 主力模型 endpoint（v3.7 实际使用）

# ---- 自主配额（每日自主派发次数上限）----
AUTONOMY_BUDGET=12                     # 0=关闭自主；12=每天最多 12 次

# ---- 邮件通知（msmtp 通道，send-result-mail.sh 使用）----
MAIL_FROM=your@mail.com
MAIL_PASS=your-smtp-password
MAIL_TO=receiver@mail.com

# ---- 飞书机器人 webhook（可选告警通道）----
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx

# ---- GitHub 凭证（服务器 .git-credentials 也有，这里供脚本取用）----
GITHUB_TOKEN=ghp_xxxxxxxx
